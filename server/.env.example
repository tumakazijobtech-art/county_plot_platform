PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/county_plot_hub
CLIENT_ORIGIN=http://localhost:5173
APP_ORIGIN=http://localhost:5173
DEMO_MODE=true
BOOKING_HOLD_MINUTES=20
OTP_SECRET=replace-with-a-long-random-value

# Admin access (change these before production)
ADMIN_EMAIL=admin@countyshowgrounds.test
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=County Showgrounds Admin

# Free email option: Brevo offers a free daily sending allowance.
# Leave BREVO_API_KEY empty in demo mode; reset links are logged and shown in the admin UI.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM=no-reply@your-domain.example
EMAIL_FROM_NAME=County Showgrounds

# Daraja / M-Pesa
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_PARTY_B=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:4000/api/payments/daraja/callback
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# Talk Sasa
TALKSASA_API_KEY=
TALKSASA_SENDER_ID=COUNTYHUB
TALKSASA_API_URL=https://bulksms.talksasa.com/api/v3/sms/send
